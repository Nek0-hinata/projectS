{
  "name": "project-s",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build",
    "dev": "prisma generate && next dev -p 3100",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "prisma generate",
    "lint": "next lint && npx prettier . --check",
    "lint:fix": "next lint --fix && prettier . --write -l",
    "migrate": "prisma migrate dev",
    "postmigrate": "npx @snaplet/seed --config prisma/seed/seed.config.ts sync",
    "prepare": "husky",
    "seed": "node -r dotenv/config prisma/seed.js",
    "start": "next start"
  },
  "dependencies": {
    "@ant-design/cssinjs": "1.23.0",
    "@ant-design/icons": "5.6.1",
    "@ant-design/nextjs-registry": "1.0.2",
    "@faker-js/faker": "8.4.1",
    "@heroicons/react": "2.2.0",
    "@prisma/client": "5.22.0",
    "@vercel/analytics": "1.5.0",
    "@vercel/postgres": "0.10.0",
    "@vercel/speed-insights": "1.2.0",
    "ahooks": "3.8.4",
    "antd": "5.24.8",
    "bcrypt": "5.1.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.13",
    "lodash": "4.17.21",
    "next": "14.2.28",
    "next-auth": "5.0.0-beta.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@snaplet/copycat": "6.0.0",
    "@snaplet/seed": "0.98.0",
    "@types/bcrypt": "5.0.2",
    "@types/lodash": "4.17.16",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vercel/style-guide": "6.0.0",
    "autoprefixer": "10.4.21",
    "commitizen": "4.3.1",
    "conventional-changelog-cli": "5.0.0",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "16.5.0",
    "dotenv-cli": "8.0.0",
    "eslint": "9.25.1",
    "eslint-config-next": "15.3.1",
    "eslint-config-prettier": "10.1.2",
    "husky": "9.1.7",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prisma": "6.6.0",
    "tailwindcss": "4.1.4",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "prisma": {
    "seed": "npx tsx prisma/seed/seed.ts"
  }
}
